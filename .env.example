# Application Environment: development | testing | production
CI_ENV=production

# Base URL (leave empty to auto-detect from HTTP_HOST)
APP_BASE_URL=https://www.thai-sanscript.com/

# Default UI language: thai | english
APP_LANGUAGE=thai

# Session & Logging
SESS_SAVE_PATH=/home/thaisans/domains/thai-sanscript.com/public_html/application/session
LOG_THRESHOLD=1

# Database Settings
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
DB_DRIVER=mysqli
